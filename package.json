{
  "name": "sonar-agent",
  "displayName": "Sonar Agent - SonarQube AI Fix & Quality Metrics",
  "description": "SonarQube and SonarCloud metrics dashboard with fix prompt dispatcher for GitHub Copilot, Antigravity, and Claude.",
  "version": "1.0.0",
  "icon": "media/icon.png",
  "publisher": "chulit",
  "repository": {
    "type": "git",
    "url": "https://github.com/chulit/sonar-agent"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "sonarqube",
    "sonarcloud",
    "sonar",
    "sonarlint",
    "code quality",
    "ai fix",
    "copilot",
    "ai agent",
    "code smell",
    "security hotspots",
    "vulnerability",
    "clean code",
    "linter",
    "static analysis",
    "code coverage"
  ],
  "activationEvents": [
    "onView:sonarAgent.overviewView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sonar-agent-container",
          "title": "Sonar Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sonar-agent-container": [
        {
          "type": "webview",
          "id": "sonarAgent.overviewView",
          "name": "Sonar Overview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "sonarAgent.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sonarAgent.selectProject",
        "title": "Select Sonar Project",
        "icon": "$(folder-active)"
      },
      {
        "command": "sonarAgent.configure",
        "title": "Configure Connection",
        "icon": "$(gear)"
      },
      {
        "command": "sonarAgent.profile.manage",
        "title": "Manage Connection Profiles"
      },
      {
        "command": "sonarAgent.resetConnection",
        "title": "Disconnect & Reset Credentials"
      },
      {
        "command": "sonarAgent.fixWithAgent",
        "title": "Fix Sonar Issue with AI Agent"
      },
      {
        "command": "sonarAgent.showLogs",
        "title": "Show Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sonarAgent.refresh",
          "when": "view == sonarAgent.overviewView",
          "group": "navigation@1"
        },
        {
          "command": "sonarAgent.selectProject",
          "when": "view == sonarAgent.overviewView",
          "group": "navigation@2"
        },
        {
          "command": "sonarAgent.configure",
          "when": "view == sonarAgent.overviewView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Sonar Agent",
      "properties": {
        "sonarAgent.serverUrl": {
          "type": "string",
          "default": "",
          "description": "SonarQube Server URL (e.g. http://localhost:9000)"
        },
        "sonarAgent.projectKey": {
          "type": "string",
          "default": "",
          "description": "SonarQube Project Key"
        },
        "sonarAgent.profiles": {
          "type": "array",
          "default": [],
          "description": "Named SonarQube connection profiles (server URL + project key each; tokens live in the OS Keychain)"
        },
        "sonarAgent.activeProfileId": {
          "type": "string",
          "default": "",
          "description": "Id of the active connection profile"
        },
        "sonarAgent.defaultAgent": {
          "type": "string",
          "default": "copilot",
          "enum": [
            "copilot",
            "antigravity",
            "claude-code",
            "cline",
            "roo-code",
            "continue",
            "codex",
            "clipboard"
          ],
          "enumDescriptions": [
            "GitHub Copilot Chat",
            "Antigravity Agent",
            "Claude Code (Official Anthropic AI coding agent)",
            "Cline (Autonomous AI coding agent)",
            "Roo Code",
            "Continue (Open-source AI assistant)",
            "Codex Agent",
            "System Clipboard (Manual paste)"
          ],
          "description": "Default target AI coding agent"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "vsce package --no-git-tag-version",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "semantic-release": "^25.0.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^1.3.1"
  }
}
