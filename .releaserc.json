{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build && npx @vscode/vsce package ${nextRelease.version} --no-git-tag-version -o sonar-agent-${nextRelease.version}.vsix",
        "publishCmd": "npx @vscode/vsce publish --packagePath sonar-agent-${nextRelease.version}.vsix && (test -z \"$OVSX_PAT\" || npx ovsx publish sonar-agent-${nextRelease.version}.vsix -p \"$OVSX_PAT\")"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "sonar-agent-*.vsix",
            "label": "Sonar Agent Extension (VSIX)"
          }
        ]
      }
    ]
  ]
}
